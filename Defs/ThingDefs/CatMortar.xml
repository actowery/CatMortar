<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Building_CatMortar</defName><label>cat mortar</label><description>A cat-themed artillery mortar. Load one colony cat or cat corpse, then launch it with disastrous results.</description><thingClass>CatMortar.Building_CatMortar</thingClass>
